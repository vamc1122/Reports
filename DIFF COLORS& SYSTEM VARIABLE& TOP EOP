REPORT ZSDR_UPDATE NO STANDARD PAGE HEADING LINE-SIZE 133 LINE-COUNT 30(2).


TABLES : VBAK,VBAP,MARC.
SELECT-OPTIONS: S_VBELN FOR VBAK-VBELN,
                S_AUART FOR VBAK-KUNNR,
                S_KUNNR FOR VBAK-KUNNR,
                S_MATNR FOR VBAP-MATNR,
                S_WERKS FOR MARC-WERKS.
TYPES : BEGIN OF TY_FINAL,
        VBELN TYPE VBAK-VBELN,
        AUDAT TYPE VBAK-AUDAT,
        AUART TYPE VBAK-AUART,
        VKORG TYPE VBAK-VKORG,
        KUNNR TYPE VBAK-KUNNR,
        POSNR TYPE VBAP-POSNR,
        MATNR TYPE VBAP-MATNR,
        MEINS TYPE VBAP-MEINS,
        KWMENG TYPE VBAP-KWMENG,
        NETPR TYPE VBAP-NETPR,
        MTART TYPE MARA-MTART,
        MBRSH TYPE MARA-MBRSH,
        MATKL TYPE MARA-MATKL,
        WERKS TYPE MARC-WERKS,
        MAKTX TYPE MAKT-MAKTX,
        NAME1 TYPE T001W-NAME1,
      END OF TY_FINAL.

DATA: IT_FINAL TYPE STANDARD TABLE OF TY_FINAL,
      WA_FINAL TYPE TY_FINAL.
REFRESH IT_FINAL[].
SELECT A~VBELN A~AUDAT  A~AUART A~VKORG A~KUNNR B~POSNR  B~MATNR B~MEINS B~KWMENG B~NETPR C~MBRSH C~MATKL D~WERKS E~MAKTX F~NAME1
  INTO TABLE IT_FINAL FROM VBAK AS A
  INNER JOIN VBAP AS B ON A~VBELN = B~VBELN
  INNER JOIN MARA AS C ON B~MATNR = C~MATNR
  INNER JOIN MARC AS D ON C~MATNR = D~MATNR
  INNER JOIN MAKT AS E ON D~MATNR = E~MATNR
  INNER JOIN T001W AS F ON  D~WERKS = F~WERKS
  WHERE A~VBELN IN S_VBELN
  AND A~AUART IN S_AUART
  AND A~KUNNR IN S_KUNNR
  AND B~MATNR IN S_MATNR
  AND D~WERKS IN S_WERKS.

  IF IT_FINAL IS NOT INITIAL .
    LOOP AT IT_FINAL INTO WA_FINAL.
      WRITE :/ WA_FINAL-VBELN,WA_FINAL-AUDAT,WA_FINAL-AUART,WA_FINAL-VKORG,WA_FINAL-KUNNR,WA_FINAL-POSNR,WA_FINAL-MATNR,WA_FINAL-MEINS,WA_FINAL-KWMENG,
      WA_FINAL-NETPR,WA_FINAL-MTART,WA_FINAL-MBRSH,WA_FINAL-MATKL,WA_FINAL-WERKS,WA_FINAL-MAKTX,WA_FINAL-NAME1.
      ULINE.

    ENDLOOP.

   ENDIF.
   ULINE.

   END-OF-PAGE.
   SKIP 1.
   WRITE:/ 'ADHIPURUSH SALAAR PROJECT K SPIRIT'COLOR 6,110'PAGE NUMBER:'COLOR 5,SY-PAGNO COLOR 1.
   ULINE.

   TOP-OF-PAGE.
   WRITE:/67 'PRABHAS'.
   WRITE:/ 'REPORT USER:       'COLOR 1, SY-UNAME COLOR 2 .
   WRITE:/ 'REPORT RUN ON/TIME:'COLOR 2, SY-UZEIT COLOR 1.
   WRITE:/ 'SYSTEM:            'COLOR 3,SY-SYSID COLOR 6.
   WRITE:/ 'REPORT RUN DATE:   'COLOR 4, SY-DATUM COLOR 3.
   SKIP 1.
   ULINE.
