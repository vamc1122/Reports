FORM usr_command  USING r_ucomm LIKE sy-ucomm
                                  rs_selfield TYPE slis_selfield       ##CALLED.

  DATA : tlines   TYPE TABLE OF tline,
         ls_tline TYPE tline.
  DATA : it_text TYPE TABLE OF tline,
         wa_text TYPE tline.
  DATA : lv_mblnr TYPE thead-tdname.
  DATA: ref_grid  TYPE REF TO cl_gui_alv_grid                            ##NEEDED.

  DATA ls_ref1 TYPE REF TO cl_gui_alv_grid .
  DATA e_grid TYPE REF TO cl_gui_alv_grid                               ##NEEDED.
  DATA : lv_finalurl TYPE string.
  DATA : textnote TYPE TABLE OF txw_note.
  DATA : w_textnote TYPE txw_note.

  CALL FUNCTION 'GET_GLOBALS_FROM_SLVC_FULLSCR'
    IMPORTING
      e_grid = ls_ref1.

  CALL METHOD ls_ref1->check_changed_data.

  SELECT * FROM zmm_vend_invoice  ##SELECT_FAE_WITH_LOB[ZURL]
    INTO TABLE it_url
   FOR ALL ENTRIES IN it_final
   WHERE zmblnr = it_final-mblnr.

  CASE r_ucomm.

    WHEN '&IC1'.
      PERFORM handle_double_click USING rs_selfield.


      CLEAR : wa_final,lv_mblnr,tlines,it_text,wa_text,textnote,lv_finalurl,lv_url.
      IF rs_selfield-fieldname = 'URL'.
        READ TABLE it_final INTO wa_final INDEX rs_selfield-tabindex.

        IF wa_final-lv_icon IS INITIAL.
          CALL FUNCTION 'TXW_TEXTNOTE_EDIT'
            EXPORTING
              edit_mode = 'X'
            TABLES
              t_txwnote = textnote.

          DELETE textnote WHERE line IS INITIAL.

          IF textnote IS NOT INITIAL.

            LOOP AT textnote INTO DATA(ls_textnote).
              MOVE ls_textnote-line TO ls_tline-tdline.
              APPEND ls_tline TO tlines.
            ENDLOOP.

            lv_mblnr = wa_final-mblnr.
            CALL FUNCTION 'CREATE_TEXT'
              EXPORTING
                fid         = 'ZURL'
                flanguage   = 'E'
                fname       = lv_mblnr
                fobject     = 'ZMBLNR'
                save_direct = 'X'
*               FFORMAT     = '*'
              TABLES
                flines      = tlines
              EXCEPTIONS
                no_init     = 1
                no_save     = 2
                OTHERS      = 3.
            IF sy-subrc <> 0.
* Implement suitable error handling here

            ELSE.

              CALL FUNCTION 'READ_TEXT'
                EXPORTING
                  client                  = sy-mandt
                  id                      = 'ZURL'
                  language                = 'E'
                  name                    = lv_mblnr
                  object                  = 'ZMBLNR'
                TABLES
                  lines                   = it_text
                EXCEPTIONS
                  id                      = 1
                  language                = 2
                  name                    = 3
                  not_found               = 4
                  object                  = 5
                  reference_check         = 6
                  wrong_access_to_archive = 7
                  OTHERS                  = 8.
              IF sy-subrc <> 0.
* Implement suitable error handling here
                MESSAGE 'URL NOT UPDATED' TYPE 'I' DISPLAY LIKE 'E'.
                LEAVE TO LIST-PROCESSING.
              ELSE.

*
                LOOP AT it_text INTO wa_text.
                  CONCATENATE lv_url wa_text-tdline INTO lv_url.
                  AT LAST.
*                    REPLACE ALL OCCURRENCES OF 'UPLOAD LINK' in wa_final-url WITH ''.
*                    CONDENSE wa_final-url.
                    wa_final-url = lv_url.
                    CONCATENATE c_url 'OPEN URL' INTO wa_final-lv_icon SEPARATED BY space.
                    CONCATENATE c_vurl 'VIEW_URL' INTO wa_final-view_url SEPARATED BY space.
                    MODIFY it_final FROM wa_final INDEX rs_selfield-tabindex.
                  ENDAT.
                ENDLOOP.

*                  READ TABLE it_text INTO wa_text INDEX 1.
*                IF sy-subrc = 0.
*                  wa_final-url = 'URL Uploaded'.
*                  CONCATENATE c_url 'OPEN URL' INTO wa_final-lv_icon SEPARATED BY space.
*                  CONCATENATE c_vurl 'VIEW_URL' INTO wa_final-view_url SEPARATED BY space.
*                  MODIFY it_final FROM wa_final INDEX rs_selfield-tabindex.
*                ENDIF.

              ENDIF.
            ENDIF.
*        ENDIF.

          ELSE.
            MESSAGE 'No Data Found to Upload' TYPE 'E' DISPLAY LIKE 'I'         ##NO_TEXT.
          ENDIF.
        ELSE.
          MESSAGE 'URL Already Updated. Please Click on VIEW/OPEN URL to View' TYPE 'E' DISPLAY LIKE 'I'        ##NO_TEXT.
        ENDIF.

      ELSEIF rs_selfield-fieldname = 'LV_ICON'.

        IF rs_selfield-value IS NOT INITIAL.
          READ TABLE it_final INTO wa_final INDEX rs_selfield-tabindex.

          lv_mblnr = wa_final-mblnr.
          CALL FUNCTION 'READ_TEXT'
            EXPORTING
              client                  = sy-mandt
              id                      = 'ZURL'
              language                = 'E'
              name                    = lv_mblnr
              object                  = 'ZMBLNR'
            TABLES
              lines                   = it_text
            EXCEPTIONS
              id                      = 1
              language                = 2
              name                    = 3
              not_found               = 4
              object                  = 5
              reference_check         = 6
              wrong_access_to_archive = 7
              OTHERS                  = 8.
          IF sy-subrc <> 0.
* Implement suitable error handling here
            MESSAGE 'URL DATA NOT FOUND' TYPE 'E' DISPLAY LIKE 'I'.
            LEAVE TO LIST-PROCESSING.

          ELSE.
            LOOP AT it_text INTO wa_text..
              CONCATENATE lv_finalurl wa_text-tdline INTO lv_finalurl.
*              AT LAST.
*                MODIFY it_final FROM wa_final INDEX rs_selfield-tabindex.
*              ENDAT.
            ENDLOOP.

            CALL METHOD cl_gui_frontend_services=>execute
              EXPORTING
                document               = lv_finalurl
*               application            =
*               parameter              =
*               default_directory      =
*               maximized              =
*               minimized              =
*               synchronous            =
                operation              = 'OPEN'
              EXCEPTIONS
                cntl_error             = 1
                error_no_gui           = 2
                bad_parameter          = 3
                file_not_found         = 4
                path_not_found         = 5
                file_extension_unknown = 6
                error_execute_failed   = 7
                synchronous_failed     = 8
                not_supported_by_gui   = 9
                OTHERS                 = 10.
            IF sy-subrc <> 0.
*         Implement suitable error handling here
              MESSAGE sy-msgno TYPE 'E'.
            ENDIF.


          ENDIF.
        ELSE.
          MESSAGE 'Invalid Selection' TYPE 'S'         ##NO_TEXT.
        ENDIF.

      ELSEIF rs_selfield-fieldname = 'VIEW_URL'.
        IF rs_selfield-value IS NOT INITIAL.
          READ TABLE it_final INTO wa_final INDEX rs_selfield-tabindex.

          lv_mblnr = wa_final-mblnr.
          CALL FUNCTION 'READ_TEXT'
            EXPORTING
              client                  = sy-mandt
              id                      = 'ZURL'
              language                = 'E'
              name                    = lv_mblnr
              object                  = 'ZMBLNR'
            TABLES
              lines                   = it_text
            EXCEPTIONS
              id                      = 1
              language                = 2
              name                    = 3
              not_found               = 4
              object                  = 5
              reference_check         = 6
              wrong_access_to_archive = 7
              OTHERS                  = 8.
          IF sy-subrc <> 0.
* Implement suitable error handling here
            MESSAGE 'URL DATA NOT FOUND' TYPE 'E' DISPLAY LIKE 'I'.
            LEAVE TO LIST-PROCESSING.

          ELSE.
            LOOP AT it_text INTO wa_text.
              w_textnote-line = wa_text-tdline.
              APPEND w_textnote TO textnote.
              CLEAR : wa_text,w_textnote.
            ENDLOOP.
            CALL FUNCTION 'TXW_TEXTNOTE_EDIT'
              EXPORTING
                edit_mode = ' '
              TABLES
                t_txwnote = textnote.

          ENDIF.
        ENDIF.
      ENDIF.

    WHEN 'SAVE'.
      READ TABLE it_final INTO wa_final WITH KEY checkbox = 'X'.
      IF sy-subrc NE 0.
        MESSAGE 'Select Atleast One Checkbox to Save the Data' TYPE 'E' DISPLAY LIKE 'I'      ##NO_TEXT.
*        LEAVE LIST-PROCESSING.
      ENDIF.
      LOOP AT it_final INTO wa_final WHERE checkbox = 'X'.
*modify it_final from  wa_final.
        FIND 'UPLOAD LINK' IN wa_final-url.
        IF sy-subrc = 0.
          CLEAR : wa_final-url.
        ENDIF.
        IF wa_final-url IS NOT INITIAL.
          wa_invoice-zmblnr = wa_final-mblnr.
          wa_invoice-zsjahr = sy-datum.
          wa_invoice-zlifnr = wa_final-lifnr.
          wa_invoice-zxblnr = wa_final-xblnr.
          wa_invoice-zwerks = wa_final-werks.
          wa_invoice-zebeln = wa_final-ebeln.
          wa_invoice-zbudat = wa_final-budat.
          wa_invoice-zcpudt = sy-datum.
          wa_invoice-zcputm = sy-uzeit.
          wa_invoice-zusnam = sy-uname.
          wa_invoice-zurl = wa_final-url.
          READ TABLE it_url INTO wa_url WITH KEY zmblnr = wa_final-mblnr.
          IF wa_url-zurl IS INITIAL.
            MODIFY zmm_vend_invoice FROM wa_invoice.
            IF sy-subrc = 0.
              COMMIT WORK AND WAIT.
              MESSAGE 'URL(s) Updated Succesfully!' TYPE 'S'          ##NO_TEXT.
            ENDIF.
          ENDIF.
        ELSE.
          MESSAGE 'Only lines with URLs Updated are saved.Maintain URLs for all the checkboxes selected' TYPE 'E' DISPLAY LIKE 'I'  ##NO_TEXT.
        ENDIF.
        CLEAR :wa_invoice.
      ENDLOOP.
  ENDCASE.
  rs_selfield-refresh = 'X'.
  CALL METHOD ls_ref1->refresh_table_display.
ENDFORM.

