*&---------------------------------------------------------------------*
*& Form get_data
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM get_data.

  SELECT werks,
         lifnr,
         budat,
         xblnr,
         mblnr,
         mjahr,
         ebeln,
         matnr,
         bwart
*         cpudt
  FROM matdoc INTO TABLE @it_matdoc
  WHERE werks EQ @p_werks
  AND   lifnr IN @s_lifnr
  AND   budat IN @s_budat
  AND   xblnr IN @s_xblnr
  AND   mblnr IN @s_mblnr
  AND   ebeln IN @s_ebeln
  AND   matnr IN @s_matnr
  AND   bwart IN @s_bwart
  AND   ebeln NE ''
  AND   lifnr NE ''.

  IF it_matdoc IS NOT INITIAL.
    SELECT lifnr,
           stcd3,                                  "#EC CI_NO_TRANSFORM
           adrnr
    FROM lfa1 INTO TABLE @DATA(it_lfa1)
    FOR ALL ENTRIES IN @it_matdoc
    WHERE lifnr = @it_matdoc-lifnr.

    SELECT * FROM mkpf INTO TABLE @DATA(it_mkpf)
    FOR ALL ENTRIES IN @it_matdoc
    WHERE mblnr = @it_matdoc-mblnr.


    SELECT * FROM zmm_vend_invoice    ##SELECT_FAE_WITH_LOB[ZURL]
    FOR ALL ENTRIES IN @it_matdoc
    WHERE zmblnr = @it_matdoc-mblnr
    INTO TABLE @DATA(it_url).                      "#EC CI_NO_TRANSFORM

    SELECT * FROM zmm_alc INTO TABLE @DATA(it_alco)
    FOR ALL ENTRIES IN @it_matdoc
    WHERE grn = @it_matdoc-mblnr.

    SELECT * FROM mseg INTO TABLE @DATA(lt_mseg)
      FOR ALL ENTRIES IN @it_matdoc
      WHERE lfbnr = @it_matdoc-mblnr
        AND lfbja = @it_matdoc-mjahr.

    SELECT * FROM rseg INTO TABLE @DATA(lt_rseh)
      FOR ALL ENTRIES IN @lt_mseg
      WHERE lfbnr = @lt_mseg-lfbnr
      AND  lfgja = @lt_mseg-lfbja.

  ENDIF.

  IF it_lfa1 IS NOT INITIAL.
    SELECT addrnumber,                             "#EC CI_NO_TRANSFORM
           name1,
           name2
    FROM adrc INTO TABLE @DATA(it_adrc)
    FOR ALL ENTRIES IN @it_lfa1
    WHERE addrnumber = @it_lfa1-adrnr.
  ENDIF.

  SORT it_matdoc BY mblnr.
  DELETE ADJACENT DUPLICATES FROM it_matdoc COMPARING mblnr.

  DATA: lv_awkey TYPE char30.

  LOOP AT it_matdoc INTO DATA(wa_matdoc).
    wa_final-werks = wa_matdoc-werks.
    wa_final-lifnr = wa_matdoc-lifnr.
    wa_final-budat = wa_matdoc-budat.
    wa_final-xblnr = wa_matdoc-xblnr.
    wa_final-mjahr = wa_matdoc-mjahr.
    wa_final-mblnr = wa_matdoc-mblnr.
    wa_final-ebeln = wa_matdoc-ebeln.
    wa_final-matnr = wa_matdoc-matnr.
    wa_final-bwart = wa_matdoc-bwart.
*    wa_final-cpudt = wa_matdoc-cpudt.

    READ TABLE it_url INTO DATA(wa_url) WITH KEY zmblnr = wa_matdoc-mblnr.

    IF sy-subrc = 0.
      wa_final-url = wa_url-zurl.
      IF wa_final-url IS NOT INITIAL.
        CONCATENATE wa_url-zchanged_on+6(2) wa_url-zchanged_on+4(2)
                    wa_url-zchanged_on+0(4) INTO  wa_final-url_date SEPARATED BY '.'.
        wa_final-url_time = wa_url-zchanged_time.
        wa_final-url_status = 'URL Updated'.
        CONCATENATE c_url 'OPEN URL' INTO wa_final-lv_icon SEPARATED BY space.
        CONCATENATE c_vurl 'VIEW URL' INTO wa_final-view_url SEPARATED BY space.
      ELSE.
        wa_final-url_status = 'URL Yet To Update'.
        CONCATENATE c_upl 'UPLOAD LINK' INTO wa_final-url SEPARATED BY space.
      ENDIF.
    ELSE.
      wa_final-url_status = 'URL Yet To Update'.
      CONCATENATE c_upl 'UPLOAD LINK' INTO wa_final-url SEPARATED BY space.
    ENDIF.

    READ TABLE it_lfa1 INTO DATA(wa_lfa1) WITH KEY lifnr = wa_matdoc-lifnr.
    IF sy-subrc = 0.
      wa_final-gst_num = wa_lfa1-stcd3.
      wa_final-adrnr = wa_lfa1-adrnr.
    ENDIF.

    READ TABLE it_adrc INTO DATA(wa_adrc) WITH KEY addrnumber = wa_lfa1-adrnr.
    IF sy-subrc = 0.
      wa_final-name1 = wa_adrc-name1.
      wa_final-name2 = wa_adrc-name2.
    ENDIF.
    READ TABLE lt_mseg INTO DATA(ls_mseg) WITH KEY   lfbnr = wa_matdoc-mblnr
                                                      lfbja = wa_matdoc-mjahr.
    IF sy-subrc = 0.
      READ TABLE lt_rseh INTO DATA(ls_rseh) WITH KEY   lfbnr = ls_MSEG-lfbnr
                                                       lfgja = ls_MSEG-lfbja.
      IF sy-subrc = 0.
        wa_final-park_num = ls_rseh-belnr.
        IF wa_final-park_num IS NOT INITIAL.
*          wa_final-park_status = 'Parked'.
        ENDIF.
        CONCATENATE ls_RSEH-belnr ls_RSEH-gjahr INTO lv_awkey.
        SELECT SINGLE * FROM bkpf INTO @DATA(ls_mkpf) WHERE awkey  = @lv_awkey.
*        wa_final-post_acc = ls_mkpf-belnr.
        IF wa_final-post_acc IS NOT INITIAL.
*          wa_final-post_status = 'Posted'.
        ENDIF.
        IF ls_mkpf-bstat NE 'V'.
          wa_final-post_status = 'Posted'.
        wa_final-post_acc = ls_mkpf-belnr.

          CONCATENATE ls_mkpf-ppdat+6(2) ls_mkpf-ppdat+4(2) ls_mkpf-ppdat+0(4)
                      INTO wa_final-park_date SEPARATED BY '.'.
          CONCATENATE ls_mkpf-cpudt+6(2) ls_mkpf-cpudt+4(2) ls_mkpf-cpudt+0(4)
                      INTO wa_final-post_date SEPARATED BY '.'.

          wa_final-park_time = ls_mkpf-pptme.
          wa_final-post_time = ls_mkpf-cputm.
          wa_final-post_doc_num = ls_rseh-belnr.
        ELSE.
          wa_final-park_status = 'Parked'.
          CONCATENATE ls_mkpf-cpudt+6(2) ls_mkpf-cpudt+4(2) ls_mkpf-cpudt+0(4) INTO wa_final-park_date SEPARATED BY '.'.
          wa_final-park_time = ls_mkpf-cpuTM.
        ENDIF.

        SELECT SINGLE * FROM bsak INTO @DATA(wa_bsak) WHERE belnr = @ls_mkpf-belnr AND gjahr = @ls_mkpf-gjahr.
        IF wa_bsak IS NOT INITIAL.
          SELECT SINGLE BANKN FROM LFBK INTO @DATA(lv_bank) WHERE lifnr = @wa_bsak-lifnr.

           wa_final-bank_acc = lv_bank.
          SELECT SINGLE * FROM bsas INTO @DATA(w_bsas) WHERE belnr = @wa_bsak-augbl AND budat = @wa_bsak-augdt AND ( bschl = '40' OR bschl = '50' ).
          IF w_bsas IS NOT INITIAL.
            wa_final-utr_num = w_bsas-xblnr.
          ENDIF.
          wa_final-payment_date = wa_bsak-augdt.
        ENDIF.
      ENDIF.
    ENDIF.

    READ TABLE it_alco INTO DATA(wa_alco) WITH KEY grn = wa_matdoc-mblnr.
    IF sy-subrc = 0.
      wa_final-alloc_user = wa_alco-user_id.
      CONCATENATE wa_alco-created_on+6(2) wa_alco-created_on+4(2) wa_alco-created_on+0(4)
       INTO wa_final-alloc_date SEPARATED BY '.'.
      wa_final-alloc_time = wa_alco-created_time.
    ENDIF.

    READ TABLE it_mkpf INTO DATA(wa_mkpf) WITH KEY mblnr = wa_matdoc-mblnr.
    IF sy-subrc = 0.
      CONCATENATE wa_mkpf-cpudt+6(2) wa_mkpf-cpudt+4(2) wa_mkpf-cpudt+0(4) INTO wa_final-grn_date SEPARATED BY '.'.
      wa_final-grn_time = wa_mkpf-cputm.
    ENDIF.

    APPEND wa_final TO it_final.
    CLEAR : wa_final, wa_matdoc,wa_mkpf,wa_alco,w_bsas,lv_bank,
            wa_bsak,ls_mkpf,ls_rseh,wa_adrc,wa_lfa1.
  ENDLOOP.

  IF p_xblnr IS NOT INITIAL.
    it_final1 = it_final.
    LOOP AT it_final1 INTO wa_final1.
      SELECT  * FROM zmm_vend_invoice INTO TABLE it_invoice1 WHERE zmblnr = wa_final1-mblnr.
      IF it_invoice1 IS NOT INITIAL.
        READ TABLE it_invoice1 INTO wa_invoice1 WITH KEY zmblnr = wa_final1-mblnr.
        IF wa_invoice1-zurl IS NOT INITIAL.
          DELETE it_final WHERE mblnr = wa_final1-mblnr.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.

ENDFORM.


