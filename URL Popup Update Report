FORM handle_double_click  USING    p_rs_selfield TYPE slis_selfield.

  IF p_rs_selfield-fieldname = 'MBLNR'.
CLEAR : lv_grn.
    READ TABLE it_final INTO DATA(wa_final) INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-mblnr.


      CALL FUNCTION 'MIGO_DIALOG'
        EXPORTING
          i_action            = 'A04'
          i_refdoc            = 'R02'
*         I_NOTREE            = 'X'
*         I_NO_AUTH_CHECK     =
          i_skip_first_screen = 'X'
*         I_DEADEND           = 'X'
          i_okcode            = 'OK_GO'
*         I_LEAVE_AFTER_POST  =
*         I_NEW_ROLLAREA      = 'X'
          i_mblnr             = lv_grn
        EXCEPTIONS
          illegal_combination = 1
          OTHERS              = 2.
      IF sy-subrc <> 0.
* Implement suitable error handling here
      ENDIF.

      " Calling MIGO transaction with the selected GRN number
*    SET PARAMETER ID 'MBL' FIELD lv_grn .
*    CALL TRANSACTION 'MIGO' AND SKIP FIRST SCREEN.

    ENDIF.
  ELSEIF p_rs_selfield-fieldname = 'PARK_NUM'.
    CLEAR: lv_grn.
    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-park_num.
      SET PARAMETER ID 'RBN' FIELD lv_grn.
      CALL TRANSACTION 'MIR4' AND SKIP FIRST SCREEN.

    ENDIF.

  ELSEIF p_rs_selfield-fieldname = 'POST_DOC_NUM'.
    CLEAR: lv_grn.
    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-post_doc_num.
      SET PARAMETER ID 'BLN' FIELD lv_grn.
      CALL TRANSACTION 'MIR4' AND SKIP FIRST SCREEN.

    ENDIF.
*
  ELSEIF p_rs_selfield-fieldname = 'POST_ACC'.
    CLEAR: lv_grn.
    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-POST_ACC.
      SET PARAMETER ID 'BLN' FIELD lv_grn.
      CALL TRANSACTION 'FB03' AND SKIP FIRST SCREEN.

    ENDIF.

  ELSEIF p_rs_selfield-fieldname = 'EBELN'.
    CLEAR: lv_grn.
    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-ebeln.
      SET PARAMETER ID 'BES' FIELD lv_grn.
      CALL TRANSACTION 'ME23N' AND SKIP FIRST SCREEN.

    ENDIF.
  ENDIF.
ENDFORM.
