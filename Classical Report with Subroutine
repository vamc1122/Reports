FORM DEFAULT_VALUES1 .


  S_MATNR-SIGN = 'I'.
  S_MATNR-OPTION = 'EQ'.
  S_MATNR-LOW = '0000000023'.
  S_MATNR-HIGH = '0000000035'.

  APPEND S_MATNR.
  CLEAR S_MATNR.

ENDFORM.
