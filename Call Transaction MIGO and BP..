FORM handle_double_click  USING    p_rs_selfield TYPE slis_selfield.

  IF p_rs_selfield-fieldname = 'MBLNR'.
CLEAR : lv_grn.
    READ TABLE it_final INTO DATA(wa_final) INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-mblnr.


      CALL FUNCTION 'MIGO_DIALOG'
        EXPORTING
          i_action            = 'A04'
          i_refdoc            = 'R02'
*         I_NOTREE            = 'X'
*         I_NO_AUTH_CHECK     =
          i_skip_first_screen = 'X'
*         I_DEADEND           = 'X'
          i_okcode            = 'OK_GO'
*         I_LEAVE_AFTER_POST  =
*         I_NEW_ROLLAREA      = 'X'
          i_mblnr             = lv_grn
        EXCEPTIONS
          illegal_combination = 1
          OTHERS              = 2.
      IF sy-subrc <> 0.
* Implement suitable error handling here
      ENDIF.

      " Calling MIGO transaction with the selected GRN number
*    SET PARAMETER ID 'MBL' FIELD lv_grn .
*    CALL TRANSACTION 'MIGO' AND SKIP FIRST SCREEN.

    ENDIF.
  ELSEIF p_rs_selfield-fieldname = 'PARK_NUM'.
    CLEAR: lv_grn.
    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-park_num.
      SET PARAMETER ID 'RBN' FIELD lv_grn.
      CALL TRANSACTION 'MIR4' AND SKIP FIRST SCREEN.

    ENDIF.

  ELSEIF p_rs_selfield-fieldname = 'LIFNR'.
    CLEAR: lv_grn.
    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.

    CONSTANTS:
  gc_activity_create  TYPE bu_aktyp VALUE '01',
  gc_activity_change  TYPE bu_aktyp VALUE '02',
  gc_activity_display TYPE bu_aktyp VALUE '03'.

data : p_bp TYPE bu_partner.
data: p_cc TYPE bukrs.

*p_bp = wa_final-lifnr.
*p_cc = '1000'.
*START-OF-SELECTION.
*  PERFORM open_bp USING p_bp p_cc gc_activity_change.

**FORM open_bp
*  USING
data : iv_bp TYPE bu_partner,
    iv_cc TYPE bukrs,
    iv_activity TYPE bu_aktyp.

iv_bp = wa_final-lifnr.
iv_cc = '1000'.
iv_activity = gc_activity_display.



  DATA:
    ls_role TYPE bus_roles.

  " need to set it as a parameter
  " so that it's read in the Company Code subscreen
  SET PARAMETER ID 'BUK' FIELD iv_cc.

  " create new request
  DATA(lo_request) = NEW cl_bupa_navigation_request( ).
  " open request with selected partner number
  lo_request->set_partner_number( iv_bp ).
  " set the activity you want the user to start the maintenance with
  lo_request->set_bupa_activity( iv_activity ). " 01 - Create, 02 - Change, 03 - Display

  " change the role of the BP to the desired one
  " together with the sub header id
  ls_role-role = 'ZFIVEN'.
  lo_request->set_bupa_partner_role( ls_role ).
  lo_request->set_bupa_sub_header_id( 'FS0001' ).

  " display general data by default
  lo_request->set_maintenance_id( 'B' ). " B - Partner

  " set start-up options
  DATA(lo_options) = NEW cl_bupa_dialog_joel_options( ).
  " start the transaction with an invisible locator
  lo_options->set_locator_visible( space ).

  " open New BDT Instance for display of selected partner
  CALL METHOD cl_bupa_dialog_joel=>start_with_navigation
    EXPORTING
      iv_request              = lo_request
      iv_options              = lo_options
      iv_in_new_internal_mode = abap_true
    EXCEPTIONS
      already_started         = 1
      not_allowed             = 2
      OTHERS                  = 3.
*ENDFORM.



    "
*    CLEAR: lv_grn.
*    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.
*    IF sy-subrc = 0.
*      lv_grn = wa_final-lifnr.
*      SET PARAMETER ID 'BPA ' FIELD lv_grn.
*      CALL TRANSACTION 'BP' AND SKIP FIRST SCREEN.
*   CLEAR: lv_grn.
*    ENDIF.
"
  ELSEIF p_rs_selfield-fieldname = 'POST_DOC_NUM'.
    CLEAR: lv_grn.
    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-post_doc_num.
      SET PARAMETER ID 'BLN' FIELD lv_grn.
      CALL TRANSACTION 'MIR4' AND SKIP FIRST SCREEN.

    ENDIF.
*
  ELSEIF p_rs_selfield-fieldname = 'POST_ACC'.
    CLEAR: lv_grn.
    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-POST_ACC.
      SET PARAMETER ID 'BLN' FIELD lv_grn.
      CALL TRANSACTION 'FB03' AND SKIP FIRST SCREEN.

    ENDIF.

  ELSEIF p_rs_selfield-fieldname = 'EBELN'.
    CLEAR: lv_grn.
    READ TABLE it_final INTO wa_final INDEX p_rs_selfield-tabindex.
    IF sy-subrc = 0.
      lv_grn = wa_final-ebeln.
      SET PARAMETER ID 'BES' FIELD lv_grn.
      CALL TRANSACTION 'ME23N' AND SKIP FIRST SCREEN.

    ENDIF.
  ENDIF.
  CLEAR: lv_grn.
