FORM usr_command  USING r_ucomm LIKE sy-ucomm
                                  rs_selfield TYPE slis_selfield       ##CALLED.

  DATA : tlines   TYPE TABLE OF tline,
         ls_tline TYPE tline.
  DATA : it_text TYPE TABLE OF tline,
         wa_text TYPE tline.
  DATA : lv_mblnr TYPE thead-tdname.
  DATA: ref_grid  TYPE REF TO cl_gui_alv_grid                            ##NEEDED.

  DATA ls_ref1 TYPE REF TO cl_gui_alv_grid .
  DATA e_grid TYPE REF TO cl_gui_alv_grid                               ##NEEDED.
  DATA : lv_finalurl TYPE string.
  DATA : textnote TYPE TABLE OF txw_note.
  DATA : w_textnote TYPE txw_note.

  CALL FUNCTION 'GET_GLOBALS_FROM_SLVC_FULLSCR'
    IMPORTING
      e_grid = ls_ref1.

  CALL METHOD ls_ref1->check_changed_data.

  SELECT * FROM zmm_vend_invoice  ##SELECT_FAE_WITH_LOB[ZURL]
    INTO TABLE it_url
   FOR ALL ENTRIES IN it_final
   WHERE zmblnr = it_final-mblnr.

  CASE r_ucomm.

    WHEN '&IC1'.
      PERFORM handle_double_click USING rs_selfield.

  ENDCASE.
  rs_selfield-refresh = 'X'.
  CALL METHOD ls_ref1->refresh_table_display.
ENDFORM.




