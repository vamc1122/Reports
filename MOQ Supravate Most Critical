  SELECT * FROM marc INTO TABLE @DATA(it_marc)
    FOR ALL ENTRIES IN @gt_final
    WHERE matnr = @gt_final-material
    AND werks = @gt_final-plant
    AND sernp NE ''.


    SORT it_final BY ship_party.
  LOOP AT gt_final INTO gs_final WHERE chkbx = 'X'.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = gs_final-material
      IMPORTING
        output = gs_final-material.
    READ TABLE it_glcc INTO wa_glcc WITH KEY plant = gs_final-plant repair_type = gs_final-repair_typ.
    IF sy-subrc = 0.
      wa_item-gl_account = wa_glcc-gl_account.
      wa_item-costcenter = wa_glcc-cost_center.
    ENDIF.

    lv_itmser = lv_itmser + 1.
    wa_item-material   = gs_final-material.
*    wa_item-ref_doc    = gs_final-po_num.
    CONCATENATE gs_final-sap_so_no gs_final-so_item INTO wa_item-item_text SEPARATED BY '/'.
    wa_item-plant      = gs_final-plant.
    wa_item-stge_loc   = gs_final-sloc.
    wa_item-move_type  = lv_move.             ""Dynamically 201 0r 202
    wa_item-entry_qnt  = gs_final-picked_qty.
    wa_item-entry_uom  = gs_final-uom.
    APPEND wa_item TO it_item.


    AT END OF ship_party.
      flag = 'X'.
    ENDAT.

    IF flag = 'X'.
      wa_head-pstng_date = sy-datum.
      wa_head-doc_date   = sy-datum.
*        wa_head-header_txt = wa_final-po_num.
      wa_code-gm_code    = '03'.
*        IF button = 'REVERSE'.
      CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
        EXPORTING
          goodsmvt_header       = wa_head
          goodsmvt_code         = wa_code
        IMPORTING
          goodsmvt_headret      = head
          materialdocument      = mat_doc
          matdocumentyear       = mat_year
        TABLES
          goodsmvt_item         = it_item
          goodsmvt_serialnumber = it_ser
          return                = it_return.
*        ENDIF.
      IF it_return IS INITIAL.
        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
          EXPORTING
            wait = 'X'.
        CALL FUNCTION 'NUMBER_GET_NEXT'
          EXPORTING
            nr_range_nr             = '01'
            object                  = 'ZSF_DLV'
            quantity                = '1'
          IMPORTING
            number                  = lv_number
            returncode              = lv_return
          EXCEPTIONS
            interval_not_found      = 1
            number_range_not_intern = 2
            object_not_found        = 3
            quantity_is_0           = 4
            quantity_is_not_1       = 5
            interval_overflow       = 6
            buffer_overflow         = 7
            OTHERS                  = 8.
        IF sy-subrc <> 0.
* Implement suitable error handling here
        ENDIF.

        IF lv_number IS NOT INITIAL.
          CONCATENATE lv_doctyp lv_number INTO lv_number.
          CONDENSE lv_number.
          SELECT mblnr, zeile,matnr FROM matdoc INTO TABLE @DATA(it_matdoc)
            WHERE mblnr = @mat_doc AND mjahr = @mat_year.
          SORT it_matdoc BY zeile ASCENDING.
          CLEAR: lv_itm,lv_matitem.
          LOOP AT gt_final INTO DATA(gs_final1) WHERE ship_party = gs_final-ship_party AND chkbx = 'X'.
            lv_itm = lv_itm + 10.
            lv_matitem = lv_matitem + 1.
            CONDENSE  lv_itm.
            gs_final1-del_no = lv_number.
            gs_final1-del_item = lv_itm.
            gs_final1-mat_doc  = mat_doc.
            READ TABLE it_matdoc INTO DATA(wa_matdoc) WITH KEY zeile = lv_matitem.
            gs_final1-mat_item = wa_matdoc-zeile.
            gs_final1-doc_year = mat_year.
            gs_final1-doc_type = lv_deltyp.  " dynamically  create(FW) reverse (RE)
            gs_final1-upd_date = sy-datum.
            gs_final1-remarks  = 'Created Successfully'.
            MODIFY gt_final FROM gs_final1 TRANSPORTING del_no
                                                        del_item
                                                        mat_doc
                                                        mat_item
                                                        doc_year
                                                        doc_type
                                                        upd_date
                                                        remarks
            WHERE sap_so_no = gs_final1-sap_so_no AND so_item = gs_final1-so_item.

            ls_claimdlv-del_no          = gs_final1-del_no.
            ls_claimdlv-del_item        = gs_final1-del_item.
            ls_claimdlv-doc_type        = gs_final1-doc_type.
            ls_claimdlv-plant           = gs_final1-plant.
            ls_claimdlv-ship_party      = gs_final1-ship_party.
            ls_claimdlv-repair          = gs_final1-repair_typ.
            ls_claimdlv-sap_so_no       = gs_final1-sap_so_no.
            ls_claimdlv-sap_item        = gs_final1-so_item.
            ls_claimdlv-mat_doc         = gs_final1-mat_doc.
            ls_claimdlv-mdoc_item       = gs_final1-mat_item.
            ls_claimdlv-doc_year        = gs_final1-doc_year.
            ls_claimdlv-material        = gs_final1-material.
            ls_claimdlv-qty             = gs_final1-picked_qty.
            ls_claimdlv-uom             = gs_final1-uom.
*              ls_claimdlv-cancel          = wa_final1-cancel.
            ls_claimdlv-upd_date        = sy-datum.
            ls_claimdlv-creat_tm        = sy-uzeit.
            ls_claimdlv-creat_by        = sy-uname.
            ls_claimdlv-sfdms_number    = gs_final1-po_num.
            ls_claimdlv-sfdms_item    = gs_final1-po_item.
            ls_claimdlv-source_system   = gs_final1-source_system.

            MODIFY zdms_claimdlv FROM ls_claimdlv.
            IF sy-subrc = 0.
              COMMIT WORK AND WAIT.
            ENDIF.
*
*
              SELECT * FROM zdms_claimdlv INTO TABLE @DATA(it_short) WHERE sfdms_number = @gs_final1-po_num  AND sfdms_item = @gs_final1-po_item.
              IF it_short IS NOT INITIAL.
                CLEAR: lv_pick.
                READ TABLE it_short INTO DATA(wa_short) WITH KEY sfdms_number = gs_final1-po_num  sfdms_item = gs_final1-po_item.
                IF sy-subrc = 0.
                  LOOP AT it_short INTO wa_short WHERE sfdms_number = gs_final1-po_num AND sfdms_item = gs_final1-po_item.
                    lv_pick  = lv_pick + wa_short-qty.
                    CLEAR: wa_short.
                  ENDLOOP.
                  lv_pick = gs_final1-required_qty - lv_pick.
                  IF lv_pick = 0.  " complete
                    ls_claimpo-status_item = 'C'.
                  ELSEIF lv_pick GT 0. " partial
                    hdr_short = 'X'.
                    ls_claimpo-status_item = 'P'.
                  ELSE.
                    ls_claimpo-status_item = 'C'.
                  ENDIF.
                  " Item Level PO table Update
                  UPDATE  zdms_claimpo  SET  status_item = ls_claimpo-status_item short = ls_claimpo-short
                  WHERE sap_doc = gs_final1-sap_so_no AND sap_item = gs_final1-so_item.
                  IF sy-subrc = 0.
                    COMMIT WORK AND WAIT.
                  ENDIF.

                ENDIF.
              ENDIF.
*
              AT END OF sap_so_no.
                IF hdr_short = 'X'.
                  ls_claimpo-status_hdr = 'P'.
                ELSE.
                  ls_claimpo-status_hdr = 'C'.
                ENDIF.
                " Header Level PO table Update
                UPDATE  zdms_claimpo  SET status_hdr = ls_claimpo-status_hdr
                WHERE sap_doc = gs_final1-sap_so_no.
                IF sy-subrc = 0.
                  COMMIT WORK AND WAIT.
                ENDIF.
                CLEAR: hdr_short.
              ENDAT.


            CLEAR: wa_matdoc,gs_final1,ls_sfgrn,ls_excgrn,ls_claimdlv,ls_claimpo,lv_qty.
*              REFRESH : it_short.
          ENDLOOP.
        ENDIF.

      ELSE.
        LOOP AT it_return INTO DATA(wa) WHERE type = 'E'.
          gs_final-remarks = wa-message.
        ENDLOOP.
        MODIFY gt_final FROM gs_final TRANSPORTING remarks WHERE ship_party = gs_final-ship_party.
      ENDIF.

      CLEAR: flag,wa_head,head,mat_doc,mat_year,lv_number,lv_itmser.
      REFRESH : it_item,it_return,it_matdoc,it_ser.
    ENDIF.
    CLEAR: gs_final,wa_item.
  ENDLOOP.
