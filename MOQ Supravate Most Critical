FORM process_data.
  CLEAR: lv_doctyp.

  IF r_rr IS NOT INITIAL.
    SELECT * FROM zdms_claimpo INTO TABLE it_claimpo WHERE doc_type = 'RR'
                                                       AND sap_doc IN s_sono
                                                       AND po_num IN s_pono
                                                       AND plant IN s_plant
                                                       AND creat_dt IN s_cretdt
                                                       AND status_item NE 'C'
                                                       AND short NE 'X'
                                                       AND sold_party IN s_soldto.
    lv_doctyp = 'RR'.
  ELSEIF r_sn IS NOT INITIAL.
    SELECT * FROM zdms_claimpo INTO TABLE it_claimpo WHERE doc_type = 'SN'
                                                       AND sap_doc IN s_sono
                                                       AND po_num IN s_pono
                                                       AND plant IN s_plant
                                                       AND creat_dt IN s_cretdt
*                                                       AND status_item NE 'C'
                                                       AND short NE 'X'
                                                       AND sold_party IN s_soldto.


    lv_doctyp = 'SN'.
  ELSEIF r_dn IS NOT INITIAL.
    SELECT * FROM zdms_claimpo INTO TABLE it_claimpo WHERE doc_type = 'DN'
                                                      AND sap_doc IN s_sono
                                                       AND po_num IN s_pono
                                                       AND plant IN s_plant
                                                       AND creat_dt IN s_cretdt
                                                       AND status_item NE 'C'
                                                       AND short NE 'X'
                                                       AND sold_party IN s_soldto.


    lv_doctyp = 'DN'.

  ELSEIF r_report = 'X'.
    SELECT * FROM zdms_claimpo INTO TABLE it_claimpo WHERE sap_doc IN s_sono
                                                       AND po_num IN s_pono
                                                       AND plant IN s_plant
                                                       AND creat_dt IN s_cretdt
                                                       AND sold_party IN s_soldto.

  ENDIF.

  IF it_claimpo  IS NOT INITIAL.
    LOOP AT it_claimpo INTO DATA(wa_claimpo).

      wa_final-chkbx          = 'X'.
      wa_final-sap_so_no      = wa_claimpo-sap_doc.
      wa_final-so_item        = wa_claimpo-sap_item.
      wa_final-plant          = wa_claimpo-plant.
      wa_final-moq            = wa_claimpo-moq.
      wa_final-short_close    = ' '.
      wa_final-repair_typ     = wa_claimpo-repair.
      wa_final-sloc           = p_sloc.
      wa_final-po_num         = wa_claimpo-po_num.
      wa_final-po_item        = wa_claimpo-po_item.
      wa_final-material       = wa_claimpo-material.
      wa_final-ship_party     = wa_claimpo-ship_party.
      wa_final-sold_party     = wa_claimpo-sold_party.
      wa_final-required_qty   = wa_claimpo-qty.
      wa_final-picked_qty     = wa_claimpo-qty.
      wa_final-uom            = wa_claimpo-uom.
      wa_final-source_system  = wa_claimpo-source_system.
      APPEND wa_final TO it_final.
      CLEAR wa_final.
    ENDLOOP.

    SORT it_final BY ship_party sap_so_no so_item.
    IF lv_doctyp = 'DN' OR lv_doctyp = 'SN'.
      SELECT * FROM zdms_claimdlv INTO  TABLE @it_delivery
        FOR ALL ENTRIES IN @it_final
        WHERE sap_so_no = @it_final-sap_so_no
        AND sap_item = @it_final-so_item.
      IF it_delivery IS NOT INITIAL.

        IF lv_doctyp = 'DN'.
          LOOP AT it_delivery INTO wa_delivery WHERE doc_type = 'RE'.
            DELETE it_final WHERE sap_so_no = wa_delivery-sap_so_no AND so_item = wa_delivery-sap_item.
            CLEAR: wa_delivery.
          ENDLOOP.
        ENDIF.
        IF lv_doctyp = 'SN'.
          CLEAR: dn_re,dn_fw.
          LOOP AT it_delivery INTO wa_delivery.
            IF wa_delivery-doc_type = 'RE'.
              dn_re = 'X'.
            ELSEIF wa_delivery-doc_type = 'FW'.
              dn_fw = 'X'.
            ENDIF.
            IF dn_re = 'X' AND dn_fw = 'X'.
              DELETE it_final WHERE sap_so_no = wa_delivery-sap_so_no AND so_item = wa_delivery-sap_item.
            ENDIF.

            CLEAR: wa_delivery.
          ENDLOOP.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
ENDFORM.

