*& Form del_Creation
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM del_Creation.

  REFRESH :it_glcc.
  SELECT * FROM zsfdms_warccgl INTO TABLE it_glcc WHERE plant IN s_plant.

  IF it_final IS NOT INITIAL.
    DATA(lt_final) = it_final.
    DELETE it_final WHERE chkbx IS INITIAL.
    DELETE it_final WHERE remarks IS NOT INITIAL.
    DELETE lt_final WHERE remarks IS INITIAL AND chkbx IS NOT INITIAL.
    DELETE it_final WHERE moq_flag IS NOT INITIAL.

    SELECT * FROM marc INTO TABLE @DATA(it_marc)
      FOR ALL ENTRIES IN @it_final
      WHERE matnr = @it_final-material
      AND werks = @it_final-plant
      AND sernp NE ''.


    SORT it_final BY sap_so_no so_item.
    LOOP AT it_final INTO wa_final WHERE chkbx = 'X'.
      "" for MOQ


      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = wa_final-material
        IMPORTING
          output = wa_final-material.
      READ TABLE it_glcc INTO wa_glcc WITH KEY plant = wa_final-plant repair_type = wa_final-repair_typ.
      IF sy-subrc = 0.
        wa_item-gl_account = wa_glcc-gl_account.
        wa_item-costcenter = wa_glcc-cost_center.
      ENDIF.

      lv_itmser = lv_itmser + 1.
      wa_item-material   = wa_final-material.
      wa_item-ref_doc    = wa_final-sap_so_no.
      CONCATENATE wa_final-sap_so_no wa_final-so_item INTO wa_item-item_text SEPARATED BY '/'.
      wa_item-plant      = wa_final-plant.
      wa_item-stge_loc   = wa_final-sloc.
      wa_item-move_type  = lv_move.             ""Dynamically 201 0r 202
      wa_item-entry_qnt  = wa_final-picked_qty.
      wa_item-entry_uom  = wa_final-uom.
      APPEND wa_item TO it_item.

      IF button = 'REVERSE'.
        READ TABLE it_marc INTO DATA(wa_marc) WITH KEY matnr = wa_final-material.
        IF sy-subrc = 0.
          READ TABLE it_claimpo INTO DATA(wa_po) WITH KEY sap_doc = wa_final-sap_so_no sap_item = wa_final-so_item.
          IF sy-subrc = 0.

            SELECT * FROM zdms_claimsrl INTO TABLE it_srl WHERE del_no = wa_po-del_no AND del_item = wa_po-del_item.
            IF it_srl IS NOT INITIAL.
              LOOP AT it_srl INTO wa_srl.
                wa_ser-serialno = wa_srl-ser_no.
                wa_ser-matdoc_itm = lv_itmser.
                APPEND wa_ser TO it_ser.
              ENDLOOP.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.

      AT END OF sap_so_no.
        flag = 'X'.
      ENDAT.

      IF flag = 'X'.
        wa_head-pstng_date = sy-datum.
        wa_head-doc_date   = sy-datum.
        wa_head-header_txt = wa_final-po_num.
        wa_code-gm_code    = '03'.
*        IF button = 'REVERSE'.
        CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
          EXPORTING
            goodsmvt_header       = wa_head
            goodsmvt_code         = wa_code
          IMPORTING
            goodsmvt_headret      = head
            materialdocument      = mat_doc
            matdocumentyear       = mat_year
          TABLES
            goodsmvt_item         = it_item
            goodsmvt_serialnumber = it_ser
            return                = it_return.
*        ENDIF.
        IF it_return IS INITIAL.
          CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
            EXPORTING
              wait = 'X'.
          CALL FUNCTION 'NUMBER_GET_NEXT'
            EXPORTING
              nr_range_nr             = '01'
              object                  = 'ZSF_DLV'
              quantity                = '1'
            IMPORTING
              number                  = lv_number
              returncode              = lv_return
            EXCEPTIONS
              interval_not_found      = 1
              number_range_not_intern = 2
              object_not_found        = 3
              quantity_is_0           = 4
              quantity_is_not_1       = 5
              interval_overflow       = 6
              buffer_overflow         = 7
              OTHERS                  = 8.
          IF sy-subrc <> 0.
* Implement suitable error handling here
          ENDIF.

          IF lv_number IS NOT INITIAL.
            CONCATENATE lv_doctyp lv_number INTO lv_number.
            CONDENSE lv_number.
            SELECT mblnr, zeile,matnr FROM matdoc INTO TABLE @DATA(it_matdoc) WHERE mblnr = @mat_doc.
            CLEAR: lv_itm,lv_matitem.
            LOOP AT it_final INTO DATA(wa_final1) WHERE sap_so_no = wa_final-sap_so_no AND chkbx = 'X'.
              lv_itm = lv_itm + 10.
              lv_matitem = lv_matitem + 1.
              CONDENSE  lv_itm.
              wa_final1-del_no = lv_number.
              wa_final1-del_item = lv_itm.
              wa_final1-mat_doc  = mat_doc.
              READ TABLE it_matdoc INTO DATA(wa_matdoc) WITH KEY zeile = lv_matitem.
              wa_final1-mat_item = wa_matdoc-zeile.
              wa_final1-doc_year = mat_year.
              wa_final1-doc_type = lv_deltyp.  " dynamically  create(FW) reverse (RE)
              wa_final1-upd_date = sy-datum.
              wa_final1-remarks  = 'Created Successfully'.
              MODIFY it_final FROM wa_final1 TRANSPORTING del_no
                                                          del_item
                                                          mat_doc
                                                          mat_item
                                                          doc_year
                                                          doc_type
                                                          upd_date
                                                          remarks
              WHERE sap_so_no = wa_final1-sap_so_no AND so_item = wa_final1-so_item.
              ls_claimdlv-del_no          = wa_final1-del_no.
              ls_claimdlv-del_item        = wa_final1-del_item.
              ls_claimdlv-doc_type        = wa_final1-doc_type.
              ls_claimdlv-plant           = wa_final1-plant.
              ls_claimdlv-ship_party      = wa_final1-ship_party.
              ls_claimdlv-repair          = wa_final1-repair_typ.
              ls_claimdlv-sap_so_no       = wa_final1-sap_so_no.
              ls_claimdlv-sap_item        = wa_final1-so_item.
              ls_claimdlv-mat_doc         = wa_final1-mat_doc.
              ls_claimdlv-mdoc_item       = wa_final1-mat_item.
              ls_claimdlv-doc_year        = wa_final1-doc_year.
              ls_claimdlv-material        = wa_final1-material.
              ls_claimdlv-qty             = wa_final1-picked_qty.
              ls_claimdlv-uom             = wa_final1-uom.
*              ls_claimdlv-cancel          = wa_final1-cancel.
              ls_claimdlv-upd_date        = sy-datum.
              ls_claimdlv-creat_tm        = sy-uzeit.
              ls_claimdlv-creat_by        = sy-uname.
              ls_claimdlv-sfdms_number    = wa_final1-po_num.
              ls_claimdlv-sfdms_item    = wa_final1-po_item.
              ls_claimdlv-source_system   = wa_final1-source_system.

              MODIFY zdms_claimdlv FROM ls_claimdlv.
              IF sy-subrc = 0.
                COMMIT WORK AND WAIT.
              ENDIF.


              SELECT * FROM zdms_claimdlv INTO TABLE @DATA(it_short) WHERE sfdms_number = @wa_final1-po_num  AND sfdms_item = @wa_final1-po_item.
              IF it_short IS NOT INITIAL.
                CLEAR: lv_pick.
                READ TABLE it_short INTO DATA(wa_short) WITH KEY sfdms_number = wa_final1-po_num  sfdms_item = wa_final1-po_item.
                IF sy-subrc = 0.
                  LOOP AT it_short INTO wa_short WHERE sfdms_number = wa_final1-po_num AND sfdms_item = wa_final1-po_item.
                    lv_pick  = lv_pick + wa_short-qty.
                    CLEAR: wa_short.
                  ENDLOOP.
                  lv_pick = wa_final1-required_qty - lv_pick.
                  IF lv_pick = 0.  "complete
                    ls_claimpo-status_item = 'C'.
                  ELSEIF lv_pick GT 0. " partial
                    hdr_short = 'X'.
                    ls_claimpo-status_item = 'P'.
                  ELSE.
                    ls_claimpo-status_item = 'C'.
                  ENDIF.
                  "Item Level PO table Update
                  UPDATE  zdms_claimpo  SET  status_item = ls_claimpo-status_item short = ls_claimpo-short
                  WHERE sap_doc = wa_final1-sap_so_no AND sap_item = wa_final1-so_item.
                  IF sy-subrc = 0.
                    COMMIT WORK AND WAIT.
                  ENDIF.

                ENDIF.
              ENDIF.

              AT END OF sap_so_no.
                IF hdr_short = 'X'.
                  ls_claimpo-status_hdr = 'P'.
                ELSE.
                  ls_claimpo-status_hdr = 'C'.
                ENDIF.
                " Header Level PO table Update
                UPDATE  zdms_claimpo  SET status_hdr = ls_claimpo-status_hdr
                WHERE sap_doc = wa_final1-sap_so_no.
                IF sy-subrc = 0.
                  COMMIT WORK AND WAIT.
                ENDIF.
                CLEAR: hdr_short.
              ENDAT.


              CLEAR: wa_matdoc,wa_final1,ls_sfgrn,ls_excgrn,ls_claimdlv,ls_claimpo,lv_qty.
              REFRESH : it_short.
            ENDLOOP.
          ENDIF.

        ELSE.
          LOOP AT it_return INTO DATA(wa) WHERE type = 'E'.
            wa_final-remarks = wa-message.
          ENDLOOP.
          MODIFY it_final FROM wa_final TRANSPORTING remarks WHERE sap_so_no = wa_final-sap_so_no.
        ENDIF.

        CLEAR: flag,wa_head,head,mat_doc,mat_year,lv_number,lv_itmser.
        REFRESH : it_item,it_return,it_matdoc,it_ser.
      ENDIF.
      CLEAR: wa_final,wa_item.
    ENDLOOP.
    IF lv_doctyp = 'RR'.
      LOOP AT gt_final INTO DATA(gs_final).
        READ TABLE lt_final INTO DATA(ls_final) WITH KEY sap_so_no = gs_final-sap_so_no so_item = gs_final-so_item.
        if sy-subrc = 0.
          DELETE lt_final WHERE sap_so_no = gs_final-sap_so_no AND so_item = gs_final-so_item.
        endif.
      ENDLOOP.
    endif.

    APPEND LINES OF lt_final TO it_final.
    SORT it_final BY sap_so_no so_item.
    REFRESH : lt_final.

  ENDIF.


ENDFORM.
*&---------------------------------------------------------------------*
*& Form moq_validation
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM moq_validation.

  IF lv_doctyp = 'RR'.
    IF wa_final-moq GT 1.
      IF wa_final-required_qty LT wa_final-moq.
        REFRESH : it_moq.
        CLEAR: lv_moq.

        wa_final-remarks = 'Required Qty is Less Than MOQ'.
        MODIFY it_final FROM wa_final TRANSPORTING remarks
            WHERE sap_so_no = wa_final-sap_so_no AND so_item = wa_final-so_item.

        MOVE-CORRESPONDING it_final TO it_moq.
        DELETE it_moq WHERE sold_party NE wa_final-sold_party.
        DELETE it_moq WHERE material NE wa_final-material.
        DELETE it_moq WHERE green = 'X'.
        IF it_moq IS NOT INITIAL.
          CLEAR: lv_count.
          DESCRIBE TABLE it_moq LINES lv_count.
          IF lv_count > 1.
            SORT it_moq BY sap_so_no material.
            LOOP AT it_moq INTO DATA(wa_moq).
              lv_moq = lv_moq + wa_moq-required_qty.
              IF lv_moq GE wa_final-moq.
*                wa_final-remarks = 'Picked Qty is less than MOQ'.
                CLEAR: r_so_no.
                r_so_no-sign = 'I'.
                r_so_no-option = 'BT'.
                r_so_no-low = wa_final-sap_so_no.
                r_so_no-high = wa_moq-sap_so_no.
                APPEND r_so_no.
                LOOP AT it_final INTO DATA(wa_somoq) WHERE sap_so_no in r_so_no.
                wa_final-pre_moqflag = 'X'.
                wa_final-moq_flag = 'X'.
                MODIFY it_final FROM wa_final TRANSPORTING  moq_flag pre_moqflag
                    WHERE sap_so_no = wa_somoq-sap_so_no.
                CLEAR: wa_somoq.
                ENDLOOP.
*
*                MODIFY it_final FROM wa_final TRANSPORTING  moq_flag
*                    WHERE sap_so_no =  wa_moq-sap_so_no.
                EXIT.
              ELSE.
                wa_final-pre_moqflag = 'X'.
                MODIFY it_final FROM wa_final TRANSPORTING  pre_moqflag
                    WHERE sap_so_no = wa_final-sap_so_no.
                CONTINUE.
              ENDIF.
              CLEAR: wa_moq.
            ENDLOOP.
            IF wa_final-moq_flag NE 'X'.
              LOOP AT it_moq INTO wa_moq.
                wa_final-pre_moqflag = ''.
                MODIFY it_final FROM wa_final TRANSPORTING  pre_moqflag
                    WHERE sap_so_no = wa_moq-sap_so_no.
              ENDLOOP.
            ELSE.
              IF wa_final-remarks = 'Required Qty is Less Than MOQ'.
                wa_final-moq_flag = ''.
                wa_final-green = 'X'.
                MODIFY it_final FROM wa_final TRANSPORTING  moq_flag green
                    WHERE sap_so_no = wa_final-sap_so_no AND so_item  NE wa_final-so_item.
              ENDIF.
            ENDIF.
            LOOP AT it_final INTO DATA(wa_mfinal) WHERE moq_flag = 'X'.
              MOVE-CORRESPONDING wa_mfinal TO gs_final.
              APPEND gs_final TO gt_final.
            ENDLOOP.
          ENDIF.
        ENDIF.

      ELSE.
        wa_final-green = 'X'.
        MODIFY it_final FROM wa_final TRANSPORTING  green
            WHERE sap_so_no = wa_final-sap_so_no AND so_item = wa_final-so_item.

      ENDIF.
    ELSE.
      wa_final-green = 'X'.
      MODIFY it_final FROM wa_final TRANSPORTING  green
          WHERE sap_so_no = wa_final-sap_so_no AND so_item  = wa_final-so_item.
    ENDIF.
  ENDIF.
*  IF gt_final IS NOT INITIAL.
*    PERFORM moq_delivery.
*  ENDIF.
ENDFORM.
