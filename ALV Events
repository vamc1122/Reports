REPORT ZSDR_ALV_5.

TABLES : LFA1.
SELECT-OPTIONS : S_LIFNR FOR LFA1-LIFNR.
TYPE-POOLS : SLIS.
TYPES : BEGIN OF TY_LFA1,
        LIFNR TYPE LFA1-LIFNR,
        NAME1 TYPE LFA1-NAME1,
        ORT01 TYPE LFA1-ORT01,
        CHK,
      END OF TY_LFA1.

DATA :IT_LFA1 TYPE STANDARD TABLE OF TY_LFA1,
      WA_LFA1 TYPE TY_LFA1.

DATA : IT_FCAT TYPE SLIS_T_FIELDCAT_ALV,
      WA_FCAT LIKE LINE OF IT_FCAT.

DATA : IT_EVENT TYPE SLIS_T_EVENT,
       WA_EVENT LIKE LINE OF IT_EVENT.




SELECT LIFNR NAME1 ORT01
  FROM LFA1 INTO TABLE IT_LFA1
  WHERE LIFNR IN S_LIFNR.

WA_FCAT-FIELDNAME = 'CHK' .
WA_FCAT-COL_POS  = '1'.
WA_FCAT-SELTEXT_M = ' '.
WA_FCAT-CHECKBOX = 'X'.
WA_FCAT-EDIT = 'X'.
WA_FCAT-OUTPUTLEN = '3'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-FIELDNAME = 'LIFNR' .
WA_FCAT-COL_POS  = '2'.
WA_FCAT-SELTEXT_M = 'VENDOR NUMBER'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-FIELDNAME = 'NAME1' .
WA_FCAT-COL_POS  = '3'.
WA_FCAT-SELTEXT_M = 'VENDOR NAME'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_FCAT-FIELDNAME = 'ORT01' .
WA_FCAT-COL_POS  = '4'.
WA_FCAT-SELTEXT_M = 'VENDOR CITY'.
APPEND WA_FCAT TO IT_FCAT.
CLEAR WA_FCAT.

WA_EVENT-NAME = 'TOP_OF_PAGE'.
WA_EVENT-FORM = 'TP'.
APPEND WA_EVENT TO IT_EVENT.



WA_EVENT-NAME = 'PF_STATUS_SET'.
WA_EVENT-FORM = 'PS'.
APPEND WA_EVENT TO IT_EVENT.



WA_EVENT-NAME = 'UESR_COMMAND'.
WA_EVENT-FORM = 'UC'.
APPEND WA_EVENT TO IT_EVENT.

 CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
        EXPORTING
           I_CALLBACK_PROGRAM                =  SY-REPID
           IT_FIELDCAT                       =  IT_FCAT
           IT_EVENTS                         =  IT_EVENT
        TABLES
           T_OUTTAB                          = IT_LFA1.

FORM TP.
  DATA :IT_LIST TYPE SLIS_T_LISTHEADER,
        WA_LIST LIKE LINE OF IT_LIST.
  WA_LIST-INFO = 'THESE ARE VENDOR DETAILS'.
  WA_LIST-TYP = 'H'.
  APPEND WA_LIST TO IT_LIST .
  CLEAR WA_LIST.

  CALL FUNCTION 'REUSE_ALV_COMMENTARY_WRITE'
    EXPORTING
      IT_LIST_COMMENTARY       = IT_LIST.



ENDFORM.

FORM PS USING M TYPE SLIS_T_EXTAB.

      SET PF-STATUS 'VAMSI'.

ENDFORM.


FORM UC USING A LIKE SY-UCOMM
              B TYPE SLIS_SELFIELD.

  IF A = 'DISP'.

    READ TABLE IT_LFA1 INTO WA_LFA1 INDEX B-TABINDEX.
    IF SY-SUBRC = 0.
      SET PARAMETER ID 'LIF' FIELD WA_LFA1-LIFNR.
      CALL TRANSACTION 'XK03'.
      ENDIF.
      ENDIF.
ENDFORM.
