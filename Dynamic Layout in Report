FORM get_data .
  DATA: it_ysal_reg TYPE STANDARD TABLE OF zysal_reg,
        wa_ysal_reg TYPE zysal_reg.
  REFRESH it_ysal_reg.
  IF p_chk IS INITIAL.
    SELECT a~vbeln b~posnr a~fkart a~bstnk_vf a~fkdat a~knumv a~vbtyp
           a~kurrf                                                        " Added by AE2926
         a~ernam a~bukrs a~waerk a~vkorg a~vtweg a~spart a~kunrg a~kalsm
         b~matnr b~arktx b~werks b~wkreg b~aubel b~aupos
         b~vgbel b~vgpos b~fkimg b~vrkme c~name1 c~name2
         c~stcd3
*      d~auart d~objnr
         a~xblnr                                            "SHDK913355
         c~land1
* Begin of addition by AE2926
         c~regio c~spras
* End of addition by AE2926
        a~sfakn                                             "SHDK913355
         a~zterm                                            "SHDK913355
      d~auart d~objnr
      d~bstnk                            "BSOFT-51836
      b~prctr b~ktgrm a~ktgrd            "BSOFT-51836
         FROM vbrk AS a
         INNER JOIN vbrp AS b
         ON a~vbeln = b~vbeln
         INNER JOIN kna1 AS c
         ON a~kunrg = c~kunnr
** Begin of addition by AE2926
*         INNER JOIN t005u AS e
*         ON c~land1 = e~land1
*         AND c~regio = e~bland
*         AND c~spras = e~spras
** End of addition by AE2926
         INNER JOIN vbak AS d
         ON b~aubel = d~vbeln
         INTO TABLE tvbrkp
         WHERE a~bukrs = s_bukrs
         AND a~fkdat IN s_date
         AND b~werks IN s_werks
         AND a~fkart IN s_fkart     "BOC SHDK908607
         AND b~matnr IN s_matnr
         AND a~kunag IN s_kunag
         AND a~vtweg IN s_vtweg     "EOC SHDK908607
         AND a~fkart NE 'ZSTO'
         AND a~vbtyp NE 'U'
    AND a~vbeln IN s_vbeln.

  ELSEIF p_chk IS NOT INITIAL.
    SELECT a~vbeln b~posnr a~fkart a~bstnk_vf a~fkdat a~knumv a~vbtyp
     a~ernam a~bukrs a~waerk a~vkorg a~vtweg a~spart a~kunrg a~kalsm
     b~matnr b~arktx b~werks b~wkreg b~aubel b~aupos
     b~vgbel b~vgpos b~fkimg b~vrkme c~name1 c~name2
     c~stcd3
* Begin of addition by AE2926
         c~regio c~spras
* End of addition by AE2926
*      d~auart d~objnr
      a~xblnr                                               "SHDK913355
      c~land1                                               "SHDK913355
      a~sfakn
      a~zterm                                               "SHDK913355
       b~prctr b~ktgrm a~ktgrd        "BSOFT-51836
      FROM vbrk AS a
      INNER JOIN vbrp AS b
      ON a~vbeln = b~vbeln
      INNER JOIN kna1 AS c
      ON a~kunrg = c~kunnr
** Begin of addition by AE2926
*         INNER JOIN t005u AS e
*         ON c~land1 = e~land1
*         AND c~regio = e~bland
*         AND c~spras = e~spras
** End of addition by AE2926
*      INNER JOIN vbak AS d
*         ON b~aubel = d~vbeln
*      INTO TABLE tvbrkp
      INTO CORRESPONDING FIELDS OF TABLE tvbrkp
      WHERE a~bukrs = s_bukrs
      AND a~fkdat IN s_date
      AND b~werks IN s_werks
      AND a~fkart IN s_fkart     "BOC SHDK908607
      AND b~matnr IN s_matnr
      AND a~kunag IN s_kunag
      AND a~vtweg IN s_vtweg     "EOC SHDK908607
      AND a~fkart IN ( 'ZGST' , 'S1' )
      AND a~kalsm EQ 'ZASTOP'
    AND a~vbeln IN s_vbeln.
  ENDIF.

  IF tvbrkp[] IS NOT INITIAL.

    DATA(tvbrkp1) = tvbrkp[].
    DATA(tvbrkp2) = tvbrkp[].
    SORT tvbrkp1 BY knumv.
    SORT tvbrkp2 BY matnr werks.
    DATA(tvbrkp3) = tvbrkp2[].
    SORT tvbrkp3 BY werks.
    DATA(ttvbrkg) = tvbrkp[].
    SORT ttvbrkg BY wkreg.

    DATA(tvbrkp4) = tvbrkp[].

    SORT tvbrkp4 BY vbeln.

    DELETE ADJACENT DUPLICATES FROM tvbrkp4 COMPARING vbeln.

    IF tvbrkp4 IS NOT INITIAL.
*      BoC Radhika SHDK913355
* get payment term description
      SELECT zterm, vtext INTO TABLE @DATA(it_zterm)
        FROM tvzbt
        FOR ALL ENTRIES IN @tvbrkp4
        WHERE zterm = @tvbrkp4-zterm
      AND spras = @sy-langu.

* get cancelled invoices
      SELECT sfakn , xblnr , fkdat FROM vbrk INTO TABLE @DATA(it_canc)
        FOR ALL ENTRIES IN @tvbrkp4
      WHERE sfakn = @tvbrkp4-vbeln+(10).

*        Eoc SHDK913355
      SELECT vbeln ,
             a~kunnr,
             b~stcd3                                        "SHDK913900
            FROM vbpa AS a
        INNER JOIN kna1 AS b ON a~kunnr = b~kunnr           "SHDK913900
                      INTO TABLE @DATA(lt_vbpa)
                      FOR ALL ENTRIES IN @tvbrkp4
      WHERE vbeln = @tvbrkp4-vbeln+0(10) AND  parvw = 'WE'.

      IF sy-subrc = 0.
*select kunnr stcde into TABLE @DATA(it_ship)
        SORT lt_vbpa BY vbeln.

      ENDIF.
*      Boc Radhika 4/7/2023 Customer Category  SHDK912623
*      SELECT * FROM knvi
