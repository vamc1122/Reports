 DATA:
*      l_i_struc_job_output_info TYPE ssfcrescl,   ##NEEDED
      i_lines                   TYPE TABLE OF tline,
      lv_bin_filesize           TYPE i,
      l_xstring                 TYPE xstring,
      gwa_ssfcompop             TYPE ssfcompop,
      gwa_control               TYPE ssfctrlop,
      gv_devtype                TYPE rspoptype.
 
 DATA :i_objbin    LIKE solix OCCURS 0 WITH HEADER LINE.
  SELECT-OPTIONS : s_mailid  FOR adr6-smtp_addr NO INTERVALS.
DATA: salutation TYPE string,
      body       TYPE string,
      footer     TYPE string.

DATA: lo_send_request TYPE REF TO cl_bcs,
      lo_document     TYPE REF TO cl_document_bcs,
      lo_sender       TYPE REF TO if_sender_bcs,
      lo_recipient    TYPE REF TO if_recipient_bcs VALUE IS INITIAL,lt_message_body TYPE bcsy_text,
      lx_document_bcs TYPE REF TO cx_document_bcs, ##NEEDED
      lv_sent_to_all  TYPE os_boolean.
 DATA: lv_name1     TYPE lfa1-name1,
      lv_name2     TYPE lfa1-name2,
      lv_head      TYPE string,
      lv_smtp_addr TYPE t024-smtp_addr,
      lv_ekgrp     TYPE ekko-ekgrp,
      lv_sub       TYPE so_obj_des.
      
      
 
 CALL FUNCTION 'CONVERT_OTF'
    EXPORTING
      format                = 'PDF'
      max_linewidth         = 1024
    IMPORTING
      bin_filesize          = lv_bin_filesize
      bin_file              = l_xstring
    TABLES
      otf                   = i_otfdata1
      lines                 = i_lines
    EXCEPTIONS
      err_max_linewidth     = 1
      err_format            = 2
      err_conv_not_possible = 3
      err_bad_otf           = 4
      OTHERS                = 5 ##FM_SUBRC_OK.

* Convert Hexa String to Binary format
  CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
    EXPORTING
      buffer     = l_xstring
    TABLES
      binary_tab = i_objbin[].

** Get the Email ids for each material Purchasing group persons
  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input  = wa_bseg_d-kunnr
    IMPORTING
      output = wa_bseg_d-kunnr.

    SELECT SINGLE kunnr,
                  name1,
                  adrnr
    FROM kna1 INTO @DATA(wa_kna1)
    WHERE  kunnr = @wa_bseg_d-kunnr.

  IF p_deal IS NOT INITIAL.

    IF wa_kna1 IS NOT INITIAL.
      SELECT SINGLE addrnumber,
             consnumber,
             smtp_addr
      FROM adr6 INTO @DATA(wa_adr6)
      WHERE addrnumber = @wa_kna1-adrnr.

      IF sy-subrc = 0.
        s_mailid-sign = 'I'.
        s_mailid-option = 'EQ'.
        s_mailid-low = wa_adr6-smtp_addr.
        APPEND s_mailid.
      ENDIF.

      SORT s_mailid BY low.
      DELETE ADJACENT DUPLICATES FROM s_mailid COMPARING low.
      CLEAR:wa_adr6.

    ENDIF.
  ENDIF.

  lv_name1 = wa_kna1-name1.
  CONCATENATE lv_name1 ',' INTO lv_name1.
  CONDENSE lv_name1.

  TRY .
      lo_send_request = cl_bcs=>create_persistent( ).
    CATCH cx_send_req_bcs.
  ENDTRY.

  CONCATENATE 'Dear' lv_name1 INTO lv_head SEPARATED BY space ##NO_TEXT.
  "create message body and subject
  salutation = lv_head.
  APPEND salutation TO lt_message_body.
  APPEND INITIAL LINE TO lt_message_body.

  " body
  lv_name1 = wa_kna1-name1.
  lv_name2 = wa_bseg_d-belnr.
  CONCATENATE 'Please find the attached Credit Note in PDF format.' lv_name2 INTO body SEPARATED BY '-' ##NO_TEXT.
  APPEND body TO lt_message_body.
  APPEND INITIAL LINE TO lt_message_body.
  APPEND INITIAL LINE TO lt_message_body.
  APPEND INITIAL LINE TO lt_message_body.
  APPEND INITIAL LINE TO lt_message_body.

  footer = 'Thanks,' ##NO_TEXT..
  APPEND footer TO lt_message_body.
  "put your text into the document
  CONCATENATE 'Debit Note' lv_name2 lv_name1 INTO lv_sub SEPARATED BY '-'  ##NO_TEXT.

TRY.
  lo_document = cl_document_bcs=>create_document(
  i_type = 'RAW'
  i_text = lt_message_body
  i_subject = lv_sub ).
    CATCH cx_document_bcs.
  ENDTRY.


  TRY.
      lo_document->add_attachment(
      EXPORTING
      i_attachment_type = 'PDF'
      i_attachment_subject = lv_sub
      i_att_content_hex = i_objbin[] ).
    CATCH cx_document_bcs INTO lx_document_bcs.
  ENDTRY.

** Pass the document to send request
  TRY .
      lo_send_request->set_document( lo_document ).
    CATCH cx_send_req_bcs.
  ENDTRY.

  TRY.
      lo_sender = cl_sapuser_bcs=>create( sy-uname ). "sender is the logged in user
* Set sender to send request
      TRY .
          lo_send_request->set_sender(
                EXPORTING
                i_sender = lo_sender ).
        CATCH cx_send_req_bcs.
      ENDTRY.
    CATCH cx_address_bcs.
****Catch exception here
  ENDTRY.
  "Create recipient
  LOOP AT s_mailid.
     TRY .
        lo_recipient = cl_cam_address_bcs=>create_internet_address( s_mailid-low ).
      CATCH cx_address_bcs.
    ENDTRY.
*Set recipient
    TRY.
        lo_send_request->add_recipient(
            EXPORTING
            i_recipient = lo_recipient
            i_express = 'X' ).
      CATCH cx_send_req_bcs .
**Catch exception here
    ENDTRY.
  ENDLOOP.


*  lo_send_request->add_recipient( lo_recipient ).
* Add the customer e-mail address as well

  TRY.
** Send email
      lo_send_request->send(
      EXPORTING
      i_with_error_screen = 'X' ).
      COMMIT WORK.
      IF sy-subrc = 0 ##SUBRC_AFTER_COMMIT. "mail sent successfully
        MESSAGE  'Mail sent successfully ' TYPE 'I' ##NO_TEXT.
      ENDIF.
    CATCH cx_send_req_bcs .
*catch exception here
  ENDTRY.

  REFRESH: s_mailid,lt_message_body,i_otfdata1,it_bkpf.
  CLEAR: i_otfdata1,wa_kna1,lv_name1,lv_name2.
  LOOP AT it_int_mail INTO wa_int_mail.
    s_mailid-sign = 'I' .
    s_mailid-option = 'BT'.
    s_mailid-low = wa_int_mail-low.
    APPEND s_mailid.
  ENDLOOP.
