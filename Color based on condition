REPORT ZPRC1.

 TABLES : LIKP,LIPS,VBUP.
 SELECT-OPTIONS: S_VBELN FOR LIKP-VBELN,
                 S_ERNAM FOR LIKP-ERNAM,
                 S_ERDAT FOR LIKP-ERDAT,
                 S_FKSTA FOR VBUP-FKSTA.
 TYPES : BEGIN OF TY_LIKP,
        VBELN TYPE LIKP-VBELN,
        ERNAM TYPE LIKP-ERNAM,
        ERDAT  TYPE LIKP-ERDAT,
      END OF TY_LIKP.

 TYPES : BEGIN OF TY_LIPS,
         VBELN TYPE LIPS-VBELN,
         POSNR TYPE LIPS-POSNR,
         MATNR TYPE LIPS-MATNR,
         LFIMG TYPE LIPS-LFIMG,
         VRKME TYPE LIPS-VRKME,
   END OF TY_LIPS.

TYPES : BEGIN OF TY_VBUP,
       POSNR TYPE VBUP-POSNR,
       WBSTA TYPE VBUP-WBSTA,
       FKSTA TYPE VBUP-FKSTA,
  END OF TY_VBUP.

TYPES: BEGIN OF TY_FINAL,
      VBELN TYPE LIKP-VBELN,
      ERNAM TYPE LIKP-ERNAM,
      ERDAT TYPE LIKP-ERDAT,
      POSNR TYPE LIPS-POSNR,
      MATNR TYPE LIPS-MATNR,
      LFIMG TYPE LIPS-LFIMG,
      VRKME TYPE LIPS-VRKME,
      WBSTA TYPE VBUP-WBSTA,
      FKSTA TYPE VBUP-FKSTA,
  END OF TY_FINAL.


DATA: IT_LIKP TYPE STANDARD TABLE OF TY_LIKP,
      WA_LIKP LIKE LINE OF IT_LIKP.
DATA: IT_LIPS TYPE STANDARD TABLE OF TY_LIPS,
      WA_LIPS TYPE TY_LIPS.
DATA :IT_VBUP TYPE STANDARD TABLE OF TY_VBUP,
      WA_VBUP TYPE TY_VBUP.
DATA: IT_FINAL TYPE STANDARD TABLE OF TY_FINAL,
      WA_FINAL TYPE TY_FINAL.

START-OF-SELECTION.
REFRESH IT_LIKP[].
  SELECT VBELN ERNAM ERDAT  FROM LIKP INTO TABLE IT_LIKP WHERE VBELN IN S_VBELN AND ERNAM IN S_ERNAM AND ERDAT IN S_ERDAT .
    IF IT_LIKP IS NOT INITIAL.
      SORT IT_LIKP.
 REFRESH IT_LIPS[].
  SELECT VBELN POSNR MATNR LFIMG VRKME FROM LIPS INTO TABLE IT_LIPS FOR ALL ENTRIES IN IT_LIKP WHERE VBELN = IT_LIKP-VBELN.
  IF IT_LIPS IS NOT INITIAL.
  SORT IT_LIPS.
    REFRESH  IT_VBUP[].
  SELECT POSNR WBSTA FKSTA FROM VBUP INTO TABLE IT_VBUP FOR ALL ENTRIES IN IT_LIPS WHERE POSNR = IT_LIPS-POSNR AND FKSTA IN S_FKSTA.
     ENDIF.
      ENDIF.

      LOOP AT  IT_LIKP INTO WA_LIKP.
        WA_FINAL-VBELN = WA_LIKP-VBELN.
        WA_FINAL-ERNAM = WA_LIKP-ERNAM.
        WA_FINAL-ERDAT = WA_LIKP-ERDAT.

          CLEAR WA_LIPS.
          READ TABLE IT_LIPS INTO WA_LIPS WITH KEY VBELN = WA_LIKP-VBELN BINARY SEARCH.
           IF SY-SUBRC = 0.
        WA_FINAL-POSNR = WA_LIPS-POSNR.
        WA_FINAL-MATNR = WA_LIPS-MATNR.
        WA_FINAL-LFIMG = WA_LIPS-LFIMG.
        WA_FINAL-VRKME = WA_LIPS-VRKME.
        ENDIF.
     CLEAR WA_VBUP.
     READ TABLE IT_VBUP INTO WA_VBUP WITH KEY POSNR = WA_LIPS-POSNR BINARY SEARCH.
      IF SY-SUBRC = 0.
        WA_FINAL-WBSTA = WA_VBUP-WBSTA.
        WA_FINAL-FKSTA = WA_VBUP-FKSTA.
        ENDIF.
         APPEND WA_FINAL TO IT_FINAL.
      CLEAR WA_FINAL.
      ENDLOOP.

DATA: IT_COLOR TYPE LVC_T_SCOL,
      WA_COLOR TYPE LVC_S_SCOL.

IF IT_FINAL IS NOT INITIAL.
  sort it_final.

LOOP AT IT_FINAL INTO WA_FINAL.
  WRITE : / WA_FINAL-VBELN,WA_FINAL-ERNAM,WA_FINAL-ERDAT,WA_FINAL-POSNR,WA_FINAL-MATNR,WA_FINAL-LFIMG ,WA_FINAL-VRKME,WA_FINAL-WBSTA,WA_FINAL-FKSTA.
IF WA_FINAL-LFIMG GE 8000.
  CLEAR WA_COLOR.
  WA_COLOR-FNAME = 'LFIMG'.
  WA_COLOR-COLOR-COL = '5'.
  WA_COLOR-COLOR-INT = '1'.
  WA_COLOR-COLOR-INV = '1'.
APPEND WA_COLOR TO IT_COLOR.
CLEAR WA_COLOR.
ENDIF.
ENDLOOP.
ENDIF.
